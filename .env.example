# --- Supabase (system of record) ---------------------------------------------
# Safe to expose to the browser: protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://axgrvhfwfyasiafibuye.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# --- Neon (audit + analytics mirror; optional) ---------------------------------
# Server-only. Never prefix with NEXT_PUBLIC_. If unset the app runs without it.
NEON_DATABASE_URL=

# --- Assistant (optional; free by default) --------------------------------------
# Unset = extractive answers straight from approved knowledge (no paid API calls).
# Set to let the assistant write a grounded answer from the retrieved passages.
ANTHROPIC_API_KEY=
LOIS_LLM_MODEL=claude-haiku-5-5

# --- Sign-in providers shown on /login (comma separated; must be enabled in Supabase) ---
NEXT_PUBLIC_OAUTH_PROVIDERS=google
