# --- Supabase (system of record) ---------------------------------------------
# Safe to expose to the browser: protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://axgrvhfwfyasiafibuye.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# --- Neon (audit + analytics mirror; optional) ---------------------------------
# Server-only. Never prefix with NEXT_PUBLIC_. If unset the app runs without it.
NEON_DATABASE_URL=

# --- Assistant (optional; free by default) --------------------------------------
# Unset = extractive answers straight from approved knowledge (no paid API calls).
# Set to let the assistant write a grounded answer from the retrieved passages.
ANTHROPIC_API_KEY=
LOIS_LLM_MODEL=claude-haiku-5-5

# --- Sign-in providers shown on /login (comma separated; must be enabled in Supabase) ---
NEXT_PUBLIC_OAUTH_PROVIDERS=google

# --- AI Studio models (all optional; each has a free tier except Anthropic) ---------
# Set any combination. LOIS routes each job to the best connected model and hands off between them.
GOOGLE_API_KEY=            # Gemini, free tier at aistudio.google.com
GROQ_API_KEY=              # Llama on Groq, free tier at console.groq.com
OPENROUTER_API_KEY=        # free ":free" models at openrouter.ai
# Override default model names if a provider retires one:
LOIS_MODEL_GOOGLE=gemini-2.5-flash
LOIS_MODEL_GROQ=llama-3.3-70b-versatile
LOIS_MODEL_OPENROUTER=meta-llama/llama-3.3-70b-instruct:free
# Public address people must use (sign-in starts and ends here):
NEXT_PUBLIC_SITE_URL=https://lois-operating-system20261019.vercel.app
